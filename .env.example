# Supabase project settings — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Comma-separated allowlist — must exactly match the emails you inserted into
# the `app_allowed_emails` table via supabase/schema.sql. Only these Google
# accounts can sign in.
ALLOWED_EMAILS=you@example.com,your-dm@example.com
